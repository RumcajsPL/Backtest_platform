graph TD
    A[Raw Market Data<br/>CSV/Parquet/DataFrame] --> B[DataLoader]
    B --> C[DataBundle Contract<br/>strategy + LTF + ARTF]
    C --> D[SignalGenerator]
    D --> E[SignalFrame Contract<br/>BUY/SELL signals]
    E --> F[FilterPipeline]
    F --> G[FilterResult Contract<br/>filtered signals]
    G --> H[TradeSimulator]
    H --> I[TradeResult Contract<br/>trades + statistics]
    I --> J[MetricsCalculator]
    I --> K[ReportGenerator]
    I --> L[ProgressiveTracker]
    
    subgraph "Data Layer"
        A
        B
        C
    end
    
    subgraph "Signal Layer"
        D
        E
    end
    
    subgraph "Filter Layer"
        F
        G
    end
    
    subgraph "Trade Layer"
        H
        I
    end
    
    subgraph "Reporting Layer"
        J
        K
        L
    end
    
    style C fill:#e1f5ff,stroke:#0066cc,stroke-width:2px
    style E fill:#e1f5ff,stroke:#0066cc,stroke-width:2px
    style G fill:#e1f5ff,stroke:#0066cc,stroke-width:2px
    style I fill:#e1f5ff,stroke:#0066cc,stroke-width:2px
    
    style H fill:#ffebcc,stroke:#ff9900,stroke-width:2px
    
    classDef contractClass fill:#e1f5ff,stroke:#0066cc,stroke-width:2px
    classDef moduleClass fill:#f0f0f0,stroke:#666,stroke-width:2px