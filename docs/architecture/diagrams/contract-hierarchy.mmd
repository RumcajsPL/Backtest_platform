classDiagram
    class DataBundle {
        +DataFrame full
        +DataFrame strategy
        +DataFrame ltf
        +DataFrame artf
        +DataInfo info
        +DataValidationResult validation
        +has_ltf() bool
        +has_artf() bool
    }
    
    class SignalFrame {
        +Series signals
        +DataFrame indicator_data
        +Dict signal_metadata
        +count_by_type() Dict
        +iter_raw() Iterator
    }
    
    class FilterResult {
        +bool passed
        +SignalFrame signal_frame
        +FilterMetadata metadata
    }
    
    class TradeParameters {
        +float entry_price_executed
        +float stop_loss_trigger
        +float take_profit
        +float position_size
        +float sl_distance
        +float tp_distance
        +bool spread_applied
        +bool sl_adjusted
    }
    
    class TradeEntry {
        +str entry_id
        +Timestamp entry_time
        +TradeDirection direction
        +float entry_price
        +float stop_loss
        +float take_profit
        +float position_size
        +bool is_long
        +bool is_short
    }
    
    class TradeExit {
        +str exit_id
        +str entry_id
        +Timestamp exit_time
        +float exit_price
        +ExitReason exit_reason
        +float pnl_points
        +float pnl_percent
        +bool is_win
        +bool is_loss
    }
    
    class Trade {
        +TradeEntry entry
        +TradeExit exit
        +bool is_open
        +bool is_closed
        +str status
        +TradeDirection direction
        +float pnl_points
        +bool is_win
    }
    
    class RejectedSignal {
        +str rejection_id
        +Timestamp rejection_time
        +str direction
        +str rejection_stage
        +str rejection_reason
        +float current_price
    }
    
    class TradeResult {
        +List~Trade~ trades
        +List~RejectedSignal~ rejected_signals
        +int total_opened
        +int total_closed
        +int total_rejected
        +float win_rate
        +float total_pnl_points
        +to_dataframe() DataFrame
        +to_json() str
    }
    
    class TradeDirection {
        <<enumeration>>
        LONG
        SHORT
        +from_string(str) TradeDirection
        +to_string() str
    }
    
    class ExitReason {
        <<enumeration>>
        STOP_LOSS
        TAKE_PROFIT
        OPPOSITE_SIGNAL
        END_OF_DATA
        +from_string(str) ExitReason
    }
    
    TradeEntry --> TradeDirection
    TradeExit --> ExitReason
    Trade --> TradeEntry : contains
    Trade --> TradeExit : contains
    TradeResult --> Trade : contains many
    TradeResult --> RejectedSignal : contains many
    FilterResult --> SignalFrame : contains
    
